# 复制为 .env 后填入自己的 Key。任选一个国内 OpenAI 兼容接口即可。

# DeepSeek
STUDYLOOP_BASE_URL=https://api.deepseek.com/v1
STUDYLOOP_MODEL=deepseek-chat

# 通义千问（DashScope 兼容模式）
# STUDYLOOP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# STUDYLOOP_MODEL=qwen-plus

# 智谱 GLM
# STUDYLOOP_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# STUDYLOOP_MODEL=glm-4-plus

# Moonshot / Kimi
# STUDYLOOP_BASE_URL=https://api.moonshot.cn/v1
# STUDYLOOP_MODEL=moonshot-v1-32k

# Anthropic / Claude 兼容接口（含 DeepSeek、Kimi 等提供的 /anthropic 端点）
# STUDYLOOP_PROVIDER=anthropic
# STUDYLOOP_BASE_URL=https://api.deepseek.com/anthropic
# STUDYLOOP_MODEL=deepseek-chat
# 未填 STUDYLOOP_API_KEY 时，会自动复用环境变量 ANTHROPIC_API_KEY

STUDYLOOP_API_KEY=sk-your-key-here

# 可选
# STUDYLOOP_HOME=./data
# STUDYLOOP_MAX_STEPS=12
